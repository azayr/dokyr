HTTP_PORT=8888
HTTPS_PORT=8443
PUBLIC_URL=http://localhost:8888
# Direct IPv4 access is always allowed. Add space-separated control-panel domains here.
CONTROL_HOSTS=localhost
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=change-this-jwt-secret-with-at-least-32-characters
ENCRYPTION_KEY=change-this-encryption-key-with-at-least-32-characters
COOKIE_SECURE=false

# Published Dokyr image and release channel used by Settings → Platform.
DOKYR_IMAGE=ghcr.io/azayr/dokyr:latest
DOKYR_REGISTRY_IMAGE=ghcr.io/azayr/dokyr
DOKYR_UPDATE_CHANNEL=latest

# Attach the public registry domain from Infrastructure -> Registry. Dokyr then
# manages its Caddy route and automatic HTTPS. This is only a compatibility
# fallback when no domain has been saved in Dokyr.
REGISTRY_HOSTS=registry.invalid
REGISTRY_TOKEN_ISSUER=dokyr-registry
REGISTRY_TOKEN_SERVICE=dokyr-registry
# Shared only by Dokyr and its registry container. Generate a random value in production.
REGISTRY_INTERNAL_SECRET=change-this-internal-registry-secret
# Storage driver: filesystem (default) or s3.
REGISTRY_STORAGE=filesystem
# Return relative upload locations so HTTPS clients stay on their public scheme
# when Cloudflare or another reverse proxy connects to Dokyr over HTTP.
REGISTRY_HTTP_RELATIVEURLS=true

# Optional S3-compatible storage for the registry. Required when
# REGISTRY_STORAGE=s3. For MinIO, set REGISTRY_S3_ENDPOINT to the MinIO URL
# (e.g. https://minio.example.com) and REGISTRY_S3_FORCEPATHSTYLE=true.
REGISTRY_S3_REGION=
REGISTRY_S3_BUCKET=
REGISTRY_S3_ACCESSKEY=
REGISTRY_S3_SECRETKEY=
REGISTRY_S3_ENDPOINT=
REGISTRY_S3_FORCEPATHSTYLE=false
REGISTRY_S3_SECURE=true

# Optional GitLab OAuth configuration for repository access.
# For GitLab repository OAuth, use this callback URL:
# http://localhost:8888/api/integrations/oauth/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com

# Optional one-time SMTP bootstrap. When SMTP_HOST or SMTP_FROM_EMAIL is set
# and PostgreSQL has no SMTP settings row yet, these values are encrypted and
# copied into the database. After that first import, the database is the only
# source of truth and Compose restarts never overwrite changes made in the UI.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
# starttls, tls, or none
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Dokyr
SMTP_FROM_EMAIL=
SMTP_NOTIFY_DEPLOYMENT_FAILURES=true
SMTP_NOTIFY_DEPLOYMENT_SUCCESSES=false

# Built-in Stalwart mail server. Configure its public hostname once from
# Infrastructure -> Mail. The installer generates both secrets automatically;
# the values below are development placeholders only.
STALWART_IMAGE=stalwartlabs/stalwart:v0.16
STALWART_HOSTNAME=
STALWART_PUBLIC_URL=
STALWART_RECOVERY_PASSWORD=change-this-stalwart-recovery-password
STALWART_RELAY_PASSWORD=change-this-stalwart-relay-password
STALWART_SMTP_PORT=25
STALWART_SUBMISSIONS_PORT=465
STALWART_IMAPS_PORT=993
STALWART_POP3S_PORT=995
STALWART_SIEVE_PORT=4190

# Dokyr talks to the bundled container only over the internal control network.
# An external Stalwart can still be used by replacing the URL and API key.
MAIL_STALWART_URL=http://stalwart:8080
MAIL_STALWART_API_KEY=
MAIL_STALWART_USER=admin
MAIL_STALWART_PASSWORD=change-this-stalwart-recovery-password
MAIL_STALWART_HOSTNAME=
MAIL_STALWART_DEFAULT_DOMAIN=
MAIL_STALWART_RELAY_HOST=stalwart
MAIL_STALWART_RELAY_PORT=465
MAIL_STALWART_RELAY_PASSWORD=change-this-stalwart-relay-password
